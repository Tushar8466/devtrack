{
  "name": "devtrack-vscode",
  "displayName": "DevTrack: AI Code Explorer",
  "description": "Analyze GitHub repositories and OSS projects directly inside VS Code. Get repo health, contributor stats, and activity insights without leaving your editor.",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "publisher": "TusharSingla",
  "author": {
    "name": "Tushar Singla",
    "url": "https://github.com/Tushar8466"
  },
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tushar8466/devtrack.git"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "devtrack.analyzeWorkspace",
        "title": "DevTrack: Analyze Workspace"
      },
      {
        "command": "devtrack.openExplorer",
        "title": "DevTrack: Open Explorer"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}